<mujoco model="pineappleV3">
  <compiler angle="radian" meshdir="meshes/"/>

  <default>
    <default class="pinappleV3">
        <!-- margin left at the MuJoCo default of 0: a non-zero contact margin
             makes MuJoCo Warp reject box/mesh geom pairs while CCD is on, which
             breaks the procedural box/mesh terrain configs. -->
        <geom friction="0.4" condim="1"/>
        <joint damping="0.02" armature="0.004" frictionloss="0.1"/>
        <!-- The hip class carries no range: the two hips are NOT mirror images
             ([-1.0472, 0.6108] on the left, [-0.6108, 1.0472] on the right), so
             each hip joint sets its own. ctrlrange matches the effort_limit in
             pineapple_v3_constants.py. -->
        <default class="hip">
            <joint axis="1 0 0" damping="0.34" armature="0.0278" frictionloss="0.10"/>
            <motor ctrlrange="-28.0 28.0"/>
        </default>
        <default class="thigh">
            <joint axis="0 1 0" range="0 1.7453" damping="0.29122" armature="0.02810" frictionloss="0.10"/>
            <motor ctrlrange="-28.0 28.0"/>
        </default>
        <default class="calf">
            <joint axis="0 1 0" range="-3.229 0" damping="1.07257" armature="0.15915" frictionloss="0.20"/>
            <motor ctrlrange="-40.0 40.0"/>
        </default>
        <default class="visual">
            <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <default class="collision">
            <geom group="3" type="mesh" rgba="1 0 0 0.3" contype="0" conaffinity="1"/>
            <default class="wheel">
              <geom size="0.0925" priority="1" condim="3" friction="0.8 0.02 0.01"/>
              <!-- Drivetrain (armature/damping/frictionloss) is set per wheel
                   joint below from the V3 wheel sysid fit; L and R are
                   asymmetric. See scripts/sysid/logs/v3/wheel_sysid_results.md. -->
              <joint axis="0 1 0"/>
              <motor ctrlrange="-11.0 11.0"/>
            </default>
        </default>
    </default>
  </default>

  <asset>
    <material name="Opaque(255,255,255)" specular="0.5" shininess="0.5" rgba="1.000000 1.000000 1.000000 1.0"/>
    <material name="Opaque(38,83,134)" specular="0.5" shininess="0.5" rgba="0.149020 0.325490 0.525490 1.0"/>
    <material name="Opaque(20,32,65)" specular="0.5" shininess="0.5" rgba="0.078431 0.125490 0.254902 1.0"/>
